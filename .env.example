# Local examples only. Compose and Java processes must receive their own environment.
# Docker Compose reads .env; Spring Boot does not load .env automatically.
DB_NAME=durableflow
DB_PORT=5432
DB_USERNAME=replace_with_local_database_user
DB_PASSWORD=replace_with_local_database_password
# DB_URL=jdbc:postgresql://localhost:5432/durableflow
# WORKER_ID=worker-local-1
# Real provider keys belong in environment/secret manager, never workflow inputs/history.
# MODEL_PROVIDER_API_KEY=replace_in_secret_manager_only_when_real_adapter_exists
